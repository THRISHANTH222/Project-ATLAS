# App Settings
APP_NAME=Project Atlas Backend
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Firebase Credentials (If using a JSON file, provide the absolute path or paste raw JSON. If empty, Google Application Default Credentials will be used)
FIREBASE_PROJECT_ID=project-atlas-example
FIREBASE_CREDENTIALS_PATH=path/to/firebase-credentials.json
FIREBASE_CREDENTIALS_JSON=

# Supabase Storage Settings
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_BUCKET=your-bucket-name-here

# Gemini API Settings
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL_NAME=gemini-1.5-pro
